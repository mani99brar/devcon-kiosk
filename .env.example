# Settings for the kiosk relay server. Copy to .env, fill it in, then run ./start.sh.
# .env is git-ignored: never commit it. One VARIABLE=value per line, no quotes needed.

# Required. The team's access code, typed on the phone control page (sent as the X-Code header).
# Same value as access_code in the kiosks' secret.toml; at least 16 characters. Ask Manmeet.
ACCESS_CODE=

# Required. The Pis' own key, sent by each Pi as the X-Pi-Key header on every sync.
# Same value as server_pi_key in the kiosks' secret.toml; at least 32 characters. Ask Manmeet.
PI_KEY=

# Optional. Comma-separated Pi host names listed on the page even before they first connect.
PIS=kleros1,kleros2

# User and group IDs the container runs as (numeric, not root).
APP_UID=1000
APP_GID=1000
